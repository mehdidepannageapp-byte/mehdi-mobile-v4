generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  DRIVER
}

enum BookingStatus {
  DRAFT
  PAYMENT_PENDING
  SEARCHING
  SCHEDULED
  ASSIGNED
  PROPOSED
  DRIVER_EN_ROUTE
  DRIVER_ARRIVED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
}

enum IssueType {
  ENGINE
  FLAT_TIRE
  BATTERY
  ACCIDENT
  CHAIN
  OTHER
}

enum PhotoKind {
  CLIENT
  PICKUP
  DELIVERY
  INCIDENT
}

enum PaymentMethod {
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
}

enum UnavailabilityType {
  ONE_TIME
  RECURRING
}

enum ServiceType {
  ON_SITE_REPAIR
  TRANSPORT
}

enum AppointmentChangeStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Catégories de supplément autorisées par la grille tarifaire (config/pricing.ts).
// Aucun supplément hors de cette liste n'est accepté par l'API.
enum SurchargeCategory {
  DESTINATION_CHANGE
  EXTRA_DISTANCE
  NIGHT
  SUNDAY
  HOLIDAY
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

enum ContactMethod {
  CALL
  MESSAGE
}

enum CancellationRule {
  FREE_ADVANCE
  SAME_DAY_CARD_FEE
  SAME_DAY_CASH_FREE
}

enum PostPickupRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum FinancialStatus {
  PENDING
  CAPTURED
  REFUNDED
  RELEASED
  NOT_APPLICABLE
}

model User {
  id            String      @id @default(cuid())
  phone         String      @unique
  firstName     String?
  email         String?
  role          UserRole    @default(CLIENT)
  isAvailable   Boolean     @default(false)
  pushToken     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  vehicles      Vehicle[]
  clientJobs    Booking[]   @relation("ClientJobs")
  driverJobs    Booking[]   @relation("DriverJobs")
  sentMessages  Message[]
  locations     LiveLocation[]
  reviewsGiven  Review[]    @relation("ReviewsGiven")
  reviewsReceived Review[]  @relation("ReviewsReceived")
  unavailabilities Unavailability[]
  notificationPreference NotificationPreference?
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([phone, createdAt])
}

model Vehicle {
  id        String   @id @default(cuid())
  ownerId   String
  brand     String
  model     String
  plate     String?
  year      Int?
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings  Booking[]
}

model Booking {
  id                    String        @id @default(cuid())
  reference             String        @unique
  clientId              String
  driverId              String?
  vehicleId             String?
  issueType              IssueType
  issueDescription      String?
  status                 BookingStatus @default(DRAFT)
  serviceType             ServiceType   @default(TRANSPORT)
  pickupAddress          String
  pickupLatitude         Float
  pickupLongitude        Float
  // Nulles pour une réparation sur place tant qu'elle n'est pas convertie en transport (voir
  // MissionEvent "SERVICE_TYPE_CONVERTED" pour l'historique de conversion).
  destinationAddress     String?
  destinationLatitude    Float?
  destinationLongitude   Float?
  distanceKm             Float?
  scheduledFor           DateTime?
  proposedFor            DateTime?
  retryAfter             DateTime?
  estimatedPriceCents    Int
  finalPriceCents        Int?
  currency               String        @default("eur")
  paymentMethod          PaymentMethod @default(CARD)
  paymentStatus          PaymentStatus @default(PENDING)
  stripePaymentIntentId  String?
  cancellationReason     String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  completedAt            DateTime?
  client                 User          @relation("ClientJobs", fields: [clientId], references: [id])
  driver                 User?         @relation("DriverJobs", fields: [driverId], references: [id])
  vehicle                Vehicle?      @relation(fields: [vehicleId], references: [id])
  messages               Message[]
  photos                 Photo[]
  locations              LiveLocation[]
  invoice                Invoice?
  review                 Review?
  appointmentChangeRequests AppointmentChangeRequest[]
  surcharges              Surcharge[]
  incidents               Incident[]
  contactAttempts         ContactAttempt[]
  absence                 ClientAbsence?
  cancellationRecord      CancellationRecord?
  postPickupCancellationRequests PostPickupCancellationRequest[]
  events                  MissionEvent[]
  @@index([status, scheduledFor])
}

model Message {
  id        String   @id @default(cuid())
  bookingId String
  senderId  String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id])
}

model Photo {
  id        String    @id @default(cuid())
  bookingId String
  kind      PhotoKind
  url       String
  createdAt DateTime  @default(now())
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model LiveLocation {
  id        String   @id @default(cuid())
  bookingId String
  userId    String
  latitude  Float
  longitude Float
  heading   Float?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  @@index([bookingId, createdAt])
}

model Invoice {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  number      String   @unique
  amountCents Int
  pdfPath     String?
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Review {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  authorId    String
  recipientId String
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author      User     @relation("ReviewsGiven", fields: [authorId], references: [id])
  recipient   User     @relation("ReviewsReceived", fields: [recipientId], references: [id])
}

// Créneaux où le dépanneur est pris par une mission hors application. Ponctuel : plage
// startAt/endAt précise. Récurrent : jour de la semaine (0=dimanche..6=samedi, comme
// Date.getDay()) + plage horaire "HH:mm", sans date de fin, actif jusqu'à suppression.
model Unavailability {
  id        String              @id @default(cuid())
  driverId  String
  type      UnavailabilityType
  startAt   DateTime?
  endAt     DateTime?
  weekday   Int?
  startTime String?
  endTime   String?
  createdAt DateTime            @default(now())
  driver    User                @relation(fields: [driverId], references: [id], onDelete: Cascade)
  @@index([driverId])
}

// Garages partenaires suggérés comme destination. Alimentation manuelle (seed / admin DB) pour
// cette version. Le client garde toujours la possibilité de saisir une autre adresse libre.
model Garage {
  id        String   @id @default(cuid())
  name      String
  address   String
  latitude  Float
  longitude Float
  phone     String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// Demande du client de déplacer un rendez-vous programmé (SCHEDULED). L'ancien créneau
// (Booking.scheduledFor) reste valide tant que le dépanneur n'a pas accepté.
model AppointmentChangeRequest {
  id                   String                   @id @default(cuid())
  bookingId            String
  previousScheduledFor DateTime?
  proposedFor          DateTime
  status               AppointmentChangeStatus  @default(PENDING)
  requestedById        String
  decidedById          String?
  decidedAt            DateTime?
  createdAt            DateTime                 @default(now())
  booking              Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([bookingId])
}

// Supplément appliqué par le dépanneur, obligatoirement issu de la grille tarifaire
// (config/pricing.ts) : catégorie limitée, montant calculé côté serveur, traçabilité complète.
model Surcharge {
  id                 String            @id @default(cuid())
  bookingId          String
  category           SurchargeCategory
  amountCents        Int
  gridVersion        String
  authorId           String
  previousTotalCents Int
  newTotalCents      Int
  createdAt          DateTime          @default(now())
  booking            Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([bookingId])
}

model Incident {
  id          String         @id @default(cuid())
  bookingId   String
  type        String
  description String?
  status      IncidentStatus @default(OPEN)
  authorId    String
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([bookingId])
}

// Trace d'une tentative de contact (appel/message) avant qu'une absence ne soit déclarée.
model ContactAttempt {
  id        String        @id @default(cuid())
  bookingId String
  method    ContactMethod
  authorId  String
  note      String?
  createdAt DateTime      @default(now())
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([bookingId])
}

// Déclaration manuelle d'absence client (aucun délai automatique). Frais fixés à 50% du devis
// accepté (config/pricing.ts), calculés côté serveur.
model ClientAbsence {
  id           String   @id @default(cuid())
  bookingId    String   @unique
  declaredById String
  reason       String
  feeCents     Int
  createdAt    DateTime @default(now())
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// Trace d'audit d'une annulation (§2.6) : règle appliquée, base de calcul, frais, statut financier.
model CancellationRecord {
  id               String            @id @default(cuid())
  bookingId        String            @unique
  initiatedById    String
  initiatedAt      DateTime          @default(now())
  rule             CancellationRule
  basisAmountCents Int
  feeCents         Int
  financialStatus  FinancialStatus   @default(PENDING)
  reason           String?
  booking          Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// Après chargement de la moto, le client ne peut pas annuler directement : il soumet une demande,
// le dépanneur décide et, s'il l'accepte, fixe une nouvelle destination (§2.6).
model PostPickupCancellationRequest {
  id                      String                   @id @default(cuid())
  bookingId               String
  requestedById           String
  reason                  String?
  status                  PostPickupRequestStatus  @default(PENDING)
  newDestinationAddress   String?
  newDestinationLatitude  Float?
  newDestinationLongitude Float?
  decidedById             String?
  decidedAt               DateTime?
  createdAt               DateTime                 @default(now())
  booking                 Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([bookingId])
}

// Préférences de notification facultatives (push). Les communications transactionnelles
// obligatoires (confirmation de réservation, facture) ne sont jamais bloquées par ces préférences.
model NotificationPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  pushEnabled Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Historique générique des changements de statut et opérations financières d'une mission,
// pour la traçabilité support (§5).
model MissionEvent {
  id        String   @id @default(cuid())
  bookingId String
  type      String
  payload   Json?
  authorId  String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([bookingId, createdAt])
}
