{
  "name": "@mehdi/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "9.0.2",
    "multer": "2.0.2",
    "nodemailer": "7.0.10",
    "pdfkit": "0.17.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.4",
    "socket.io": "4.8.1",
    "stripe": "19.1.0",
    "twilio": "5.10.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "24.10.0",
    "@types/nodemailer": "7.0.3",
    "@types/pdfkit": "0.17.4",
    "@types/supertest": "^7.2.1",
    "prisma": "6.19.0",
    "supertest": "^7.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.0.4"
  }
}
